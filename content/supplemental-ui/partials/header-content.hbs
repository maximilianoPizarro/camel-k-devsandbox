<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="https://demo.redhat.com" target="_blank" style="margin-left: 2.5%; color: #fff !important; font-weight: 600;">
        Red Hat Demo Platform
      </a>
      <a class="navbar-item site-title" target="__blank" style="color: #fff !important;" href="{{{or site.url (or siteRootUrl siteRootPath)}}}">{{site.title}}</a>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
{{#with (or page.attributes.page-links page.component.asciidoc.attributes.page-links)}}
        <div class="navbar-item navbar-item-right-dropdown has-dropdown is-hoverable">
          <a class="navbar-link" href="#">Links</a>
          <div class="navbar-dropdown navbar-dropdown-right">
{{#each this}}
            <a class="navbar-item navbar-item-right-content" href="{{url}}" target="_blank">{{text}}</a>
{{/each}}
          </div>
        </div>
{{/with}}
      </div>
    </div>
  </nav>
</header>
